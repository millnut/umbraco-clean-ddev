# DDEV feeds this file to docker-compose interpolation and to every container's
# environment, so one definition here covers the sqlserver service, adminer, the
# bacpac-* commands and Umbraco.
#
# Committed deliberately. This is a fixed dev credential like DDEV's own db/db/db
# rather than a secret, and a fresh clone should work without a setup step.
#
# The password is spelled out twice rather than interpolated, because variable
# expansion inside .env is not reliable across DDEV and Compose. Keep them in step.

MSSQL_SA_PASSWORD=UmbracoD3v!

# This only reaches Umbraco because no appsettings.*.json declares a
# ConnectionStrings block. Program.cs registers appsettings.Local.json after the
# environment provider, so putting one back there would quietly override this.
ConnectionStrings__umbracoDbDSN=Server=sqlserver;Database=UmbracoDb;User Id=sa;Password=UmbracoD3v!;TrustServerCertificate=True
ConnectionStrings__umbracoDbDSN_ProviderName=Microsoft.Data.SqlClient
