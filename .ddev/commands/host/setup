#!/bin/bash
#ddev-silent-no-warn

## Description: Set up local development environment for new developers
## Usage: setup
## Example: "ddev setup"

LOCAL_SETTINGS="MyProject/appsettings.Local.json"
EXAMPLE_SETTINGS="MyProject/appsettings.Local.json.example"

if [ -f "$LOCAL_SETTINGS" ]; then
    echo "appsettings.Local.json already exists, skipping."
else
    if [ -f "$EXAMPLE_SETTINGS" ]; then
        cp "$EXAMPLE_SETTINGS" "$LOCAL_SETTINGS"
        echo "Created appsettings.Local.json from example template."
    else
        echo "Error: $EXAMPLE_SETTINGS not found."
        exit 1
    fi
fi

echo ""
echo "Starting DDEV..."
ddev add-on get ddev/ddev-adminer
ddev restart
